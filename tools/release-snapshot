#!/usr/bin/env python3
"""Export committed HEAD without history; retain the curation evidence beside the tree."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile

LIMIT = 50 * 1024 * 1024
HSL = re.compile(r"ma27|ma57|ma77|ma86|ma97|libhsl|coinhsl", re.I)
JOURNAL = re.compile(r"(?:^|/)(?:sources?|inputs?|library|zotero|mathpix)(?:/|$)|paper|article|journal", re.I)
PERSONAL = b"/home/tnnrpolley21"


def git(root, *args, **kwargs):
    return subprocess.check_output(["git", "-C", str(root), *args], **kwargs)


def write_blob(tree, path, mode, content):
    target = tree / path
    target.parent.mkdir(parents=True, exist_ok=True)
    if mode == "120000":
        link = os.fsdecode(content)
        if Path(link).is_absolute() or not (target.parent / link).resolve().is_relative_to(tree):
            raise ValueError(f"Symlink leaves snapshot: {path}")
        target.symlink_to(link)
    else:
        target.write_bytes(content)
        target.chmod(0o755 if mode == "100755" else 0o644)


def self_test(parent):
    with tempfile.TemporaryDirectory(dir=parent) as tmp:
        tree = Path(tmp).resolve()
        write_blob(tree, "tools/run", "100755", b"#!/bin/sh\n")
        write_blob(tree, "tools/link", "120000", b"run")
        assert (tree / "tools/run").stat().st_mode & 0o111
        assert (tree / "tools/link").read_bytes() == b"#!/bin/sh\n"
        try:
            write_blob(tree, "escape", "120000", b"../../outside")
        except ValueError:
            pass
        else:
            raise AssertionError("External symlink accepted")
        assert all(HSL.search(path) for path in ("lib/coinhsl/ma57.f", "libcoinhsl.so", "ma57d.f"))
        assert not HSL.search("normal/calculation.csv")
        assert JOURNAL.search("inputs/source/example.pdf")
    print("snapshot self-check passed")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("output", nargs="?", help="new directory under this checkout's build/release/")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    root = Path(git(Path(__file__).resolve().parent, "rev-parse", "--show-toplevel").decode().strip())
    release = root / "build/release"
    release.mkdir(parents=True, exist_ok=True)
    if args.self_test:
        self_test(release)
        return
    head = git(root, "rev-parse", "HEAD").decode().strip()
    output = Path(args.output).resolve() if args.output else release / f"snapshot-{head[:12]}"
    if output == release.resolve() or not output.is_relative_to(release.resolve()) or output.exists():
        parser.error("output must be a new directory below this checkout's build/release/")
    # Ignore rules must match the committed candidate being exported.
    if git(root, "diff", "HEAD", "--", ".gitignore", ":(glob)**/.gitignore"):
        parser.error("commit ignore-rule changes before exporting HEAD")
    entries = []
    for record in git(root, "ls-tree", "-rz", "-l", head).split(b"\0"):
        if record:
            meta, path = record.split(b"\t", 1)
            mode, kind, oid, size = meta.decode().split()
            entries.append((os.fsdecode(path), mode, kind, oid, int(size) if size != "-" else 0))
    paths = [entry[0] for entry in entries]
    ignored = subprocess.run(
        ["git", "-C", str(root), "check-ignore", "--no-index", "-z", "--stdin"],
        input=os.fsencode("\0".join(paths) + "\0"), capture_output=True, check=False,
    )
    if ignored.returncode not in (0, 1):
        raise RuntimeError(ignored.stderr.decode())
    ignored_paths = set(os.fsdecode(ignored.stdout).split("\0")) - {""}
    excluded, replacements, files = [], [], []
    tree = output / "tree"
    tree.mkdir(parents=True)
    checks = {"hsl_paths": [], "journal_pdf_paths": [], "pdf_count": 0,
              "personal_paths": {"docs": {}, "readmes": {}}}
    with subprocess.Popen(["git", "-C", str(root), "cat-file", "--batch"],
                          stdin=subprocess.PIPE, stdout=subprocess.PIPE) as objects:
        for path, mode, kind, oid, size in entries:
            if path.startswith("build/") or path in ignored_paths:
                excluded.append({"path": path, "reason": "build/" if path.startswith("build/") else "ignored"})
                continue
            if kind != "blob" or mode not in {"100644", "100755", "120000"}:
                raise ValueError(f"Unsupported Git entry: {path} ({mode} {kind})")
            objects.stdin.write(oid.encode() + b"\n")
            objects.stdin.flush()
            header = objects.stdout.readline().split()
            if len(header) != 3 or header[1] != b"blob" or int(header[2]) != size:
                raise RuntimeError(f"Invalid Git object response: {path}")
            content = objects.stdout.read(size)
            if len(content) != size or objects.stdout.read(1) != b"\n":
                raise RuntimeError(f"Truncated Git object: {path}")
            digest = hashlib.sha256(content).hexdigest()
            if size > LIMIT:
                note = path + ".sha256"
                if note in paths:
                    raise ValueError(f"Checksum note collides with tracked file: {note}")
                replacements.append({"path": path, "bytes": size, "sha256": digest, "note": note})
                content = f"{digest}  {path}\nOmitted from source snapshot: {size} bytes exceeds 50 MiB.\n".encode()
                path, mode = note, "100644"
            write_blob(tree, path, mode, content)
            files.append({"path": path, "mode": mode, "bytes": len(content),
                          "sha256": hashlib.sha256(content).hexdigest()})
            if HSL.search(path):
                checks["hsl_paths"].append(path)
            if path.lower().endswith(".pdf"):
                checks["pdf_count"] += 1
                if JOURNAL.search(path):
                    checks["journal_pdf_paths"].append(path)
            if path.startswith("docs/") or Path(path).name.lower().startswith("readme"):
                lines = sum(PERSONAL in line for line in content.splitlines())
                if lines:
                    count = {"matching_lines": lines, "occurrences": content.count(PERSONAL)}
                    if path.startswith("docs/"):
                        checks["personal_paths"]["docs"][path] = count
                    if Path(path).name.lower().startswith("readme"):
                        checks["personal_paths"]["readmes"][path] = count
        objects.stdin.close()
        if objects.wait():
            raise RuntimeError("Git object export failed")
    for item in files:
        target = tree / item["path"]
        if target.is_symlink() and not target.resolve().is_relative_to(tree):
            raise ValueError(f"Symlink chain leaves snapshot: {item['path']}")
    manifest = {"head": head, "tree": str(tree), "file_count": len(files),
                "size_bytes": sum(item["bytes"] for item in files), "threshold_bytes": LIMIT,
                "policy": "HEAD only; no Git history or refs; build/ and every ignored path excluded",
                "excluded": excluded, "replaced": replacements, "checks": checks, "files": files}
    (output / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    print(json.dumps({key: manifest[key] for key in ("head", "tree", "file_count", "size_bytes", "checks")}, indent=2))


if __name__ == "__main__":
    main()
