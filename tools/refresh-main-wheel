#!/usr/bin/env bash
# Build main's wheel in the main checkout, compare its key-solve work with the previous
# build/wheels/main-current/, and replace main-current with it (#319).
# It also keeps build/wheels/main-<commit>/, the applications' stable pin.
# An unchanged wheel is left in place; a first run copies it without a comparison.
# Run as: tools/refresh-main-wheel
set -euo pipefail
cd "$(git -C "$(dirname "${BASH_SOURCE[0]}")" worktree list --porcelain | sed -n '1s/^worktree //p')"
# IDE configuration under .serena/ is not part of the wheel, so its edits do not block a refresh.
[[ "$(git branch --show-current)" == main && -z "$(git status --porcelain --untracked-files=no -- . ':!.serena')" ]] \
    || { echo "the main checkout must be a clean main branch: $PWD" >&2; exit 1; }
bash .codex/environments/setup.sh
commit="$(git rev-parse --short=8 HEAD)"
current=build/wheels/main-current
previous="$(find "$current" -maxdepth 1 -name 'epcsaft-*.whl' 2>/dev/null || true)"
out=""
if [[ -n "$previous" ]]; then
    : "${EPCSAFT_PREVIOUS_PREPARED:?set the retained previous prepared Engine environment}"
    candidate="${EPCSAFT_CANDIDATE_PREPARED:-build/engine-meson/shared}"
    out="build/wheels/key-solves-$commit-$(date +%Y%m%dT%H%M%S)"
    tools/time-key-solves "$EPCSAFT_PREVIOUS_PREPARED" "$candidate" --pairs 1 --out "$out" \
        || grep -q '"gate_failures"' "$out/summary.json"
fi
staging="build/wheels/.staging-$commit"
rm -rf "$staging"
wheel="$(bash tools/build-engine.sh --wheel "$staging")"
trap 'rm -rf "$staging"' EXIT
sha="$(sha256sum "$wheel" | cut -d ' ' -f 1)"
# The per-commit copy is the stable pin for applications; no refresh replaces or deletes it.
mkdir -p "build/wheels/main-$commit" && cp --update=none "$wheel" "build/wheels/main-$commit/"
if [[ -n "$previous" && "$(sha256sum "$previous" | cut -d ' ' -f 1)" == "$sha" ]]; then
    echo "main-current unchanged: main $commit builds the same wheel, sha256 $sha"
    exit 0
fi
if [[ -n "$previous" ]]; then
    # The previous wheel stays with the comparison that used it.
    mv "$current" "$out/previous-main-current"
fi
mkdir -p "$current"
cp "$wheel" "$current/"
.venv/bin/python - "$out" "$commit" "$sha" >"$current/README" <<'PY'
import json, sys
out, commit, sha = sys.argv[1:]
print(f"Wheel built from main {commit}, sha256 {sha}.")
if not out:
    print("No previous main-current wheel; key-solve work not compared.")
    raise SystemExit
summary = json.load(open(f"{out}/summary.json"))
a = summary["environments"]["A"]
print(f"Key-solve work (iterations/evaluations/Hessian calls) against {a['source_revision']} / {a['native_library_sha256']}:")
for case, row in summary["cases"].items():
    note = "identical" if row["work_identical"] else f"WORK DIFFERENCE from {'/'.join(map(str, row['work_A'].values()))}"
    print(f"- {case}: {'/'.join(map(str, row['work_B'].values()))} ({note}; max scaled state difference {row['max_state_difference']:.3g})")
print(f"Evidence: {out}/")
PY
cat "$current/README"
