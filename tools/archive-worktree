#!/usr/bin/env bash
# Archive the ignored files `git worktree remove` would delete (build/ evidence, run outputs) to
# build/archive/<name>.tar.zst in this repository's main checkout, without Python environments, wheels, native build
# trees or caches, then `git worktree remove` the worktree.
# Usage: tools/archive-worktree <worktree-path> [name]
set -euo pipefail
die() { echo "archive-worktree: $*" >&2; exit 1; }
[[ $# -ge 1 && $# -le 2 ]] || die "usage: tools/archive-worktree <worktree-path> [name]"
wt=$(realpath "$1")
name=${2:-$(basename "$wt")}
owner=$(dirname "$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)")
main=$(dirname "$(git -C "$(dirname "$0")" rev-parse --path-format=absolute --git-common-dir)")
[[ $wt != "$owner" ]] || die "$wt is a main checkout, not a worktree"

[[ -z $(git -C "$wt" status --porcelain) ]] || die "$wt has uncommitted changes"
[[ -z $(git -C "$wt" rev-list -n1 HEAD --not --branches --remotes) ]] \
  || die "$wt has commits on no local or remote branch"

out=$main/build/archive/$name.tar.zst
[[ ! -e $out ]] || die "$out already exists"
mkdir -p "$(dirname "$out")"
git -C "$wt" ls-files -z --others --ignored --exclude-standard --directory \
  | tar --zstd -cf "$out" -C "$wt" \
    --exclude-tag-all=pyvenv.cfg --exclude-tag-all=build.ninja \
    --exclude='*venv*' --exclude='*-env' --exclude='*.whl' \
    --exclude=engine-meson --exclude=native-quality --exclude=native-sanitizers \
    --exclude=subprojects --exclude=compile_commands.json --exclude=__pycache__ \
    --exclude='.*_cache' --exclude=.serena --exclude='*.egg-info' \
    --null -T -
# Read back every member against the worktree: proves the tarball is complete and readable.
tar --zstd -df "$out" -C "$wt" || die "$out does not match $wt; worktree kept"
files=$(tar --zstd -tvf "$out" | grep -c '^-' || true)
echo "$out: $files files, $(du -h "$out" | cut -f1)"
git -C "$owner" worktree remove "$wt"
echo "removed $wt"
