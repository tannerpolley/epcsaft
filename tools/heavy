#!/usr/bin/env bash
# Run one build or Engine calculation with one numerical thread, admitted by
# agent-heavy when memory allows. Each checkout has its own .venv, so no shared
# environment lock is needed. Builds default to four compile jobs; a cold Engine
# build at four jobs peaked at 4.1 GiB (#319).
set -euo pipefail
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export EPCSAFT_BUILD_JOBS="${EPCSAFT_BUILD_JOBS:-4}"
exec agent-heavy --timeout "${HEAVY_TIMEOUT:-30m}" --max "${HEAVY_MAX:-8G}" "$@"
