def values(text):
    """A CSV cell or JSON value as a flat list of floats, or None for text."""
    if isinstance(text, str):
        try:
            return [float(text)]
        except ValueError:
            pass
        try:
            text = json.loads(text)
        except ValueError:
            return None
    flat = text if isinstance(text, list) else [text]
    if all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in flat):
        return [float(v) for v in flat]
    return None


def differences(a_rows, b_rows, reported=REPORTED, operands=None, comparisons=None):
    """Rows of B that differ from A outside the comparison above."""
    from epcsaft.equilibrium import (ComparisonEligibility, ComparisonMode, NumericalEstimate, Quantity,
                                      compare_equilibrium_quantity)
    estimate, eligibility = NumericalEstimate(), ComparisonEligibility()
    operands = operands or {}
    found = [dict(row=i, reason='row missing') for i in range(min(len(a_rows), len(b_rows)), max(len(a_rows), len(b_rows)))]
    for i, (a, b) in enumerate(zip(a_rows, b_rows)):
        for key in sorted((set(a) | set(b)) - reported):
            x, y = a.get(key), b.get(key)
            u, v = values(x), values(y)
            if not all(math.isfinite(w) for w in (u or []) + (v or [])):
                found.append(dict(row=i, key=key, a=x, b=y, reason='non-finite'))
                continue
            if type(x) is not type(y):
                found.append(dict(row=i, key=key, a=x, b=y, reason='kind changed'))
                continue
            if u is None or v is None:
                if x != y:
                    found.append(dict(row=i, key=key, a=x, b=y))
            elif len(u) != len(v):
                found.append(dict(row=i, key=key, a=x, b=y, reason='shape changed'))
            else:
                for j, (p, q) in enumerate(zip(u, v)):
                    quantity, ea, eb, admitted, mode = operands.get(
                        (i, key, j), (Quantity.Linear, estimate, estimate, eligibility, ComparisonMode.Strict))
                    allowance = max(1e-12, 1e-10 * max(abs(p), abs(q)))
                    result = compare_equilibrium_quantity(quantity, p, q, allowance, ea, eb, admitted, mode)
                    if comparisons is not None:
                        comparisons.append(dict(row=i, key=key, index=j, a=p, b=q, allowance=allowance,
                            error_a=ea.absolute, error_b=eb.absolute, chart_a=ea.chart, chart_b=eb.chart,
                            available_a=ea.available, available_b=eb.available, resolved_a=ea.resolved, resolved_b=eb.resolved,
                            cause_a=ea.cause, cause_b=eb.cause,
                            prerequisites={k:getattr(admitted,k) for k in ('declaration','branch','phase_matching','inventory',
                                'residual_a','residual_b','admission_a','admission_b')},
                            judgment=result.judgment, cause=result.cause, difference=result.difference,
                            chart_difference=result.chart_difference, radius_sum=result.radius_sum))
                    if result.judgment == 'failed':
                        found.append(dict(row=i, key=key, entry=j, a=p, b=q, reason=result.cause))
    return found


def neutral_comparison_operands(a_rows, b_rows):
    from epcsaft.equilibrium import ComparisonEligibility, ComparisonMode, NumericalEstimate, Quantity
    operands = {}
    # #861 authority covers the original #853 rows 49-62; other comparisons remain strict.
    for i in range(49, min(63, len(a_rows), len(b_rows))):
        a, b = a_rows[i], b_rows[i]
        estimates = [r.get('numerical_estimates') for r in (a, b)]
        if any(r['success'] and e is None for r, e in zip((a, b), estimates)):
            raise ValueError('neutral collection lacks error estimates from its originating Engine')
        eligibility = ComparisonEligibility()
        eligibility.declaration = all(a[k] == b[k] for k in ('T', 'P0'))
        eligibility.phase_matching = len(a.get('rho', [])) == len(b.get('rho', [])) == 2 and len(a.get('x', [])) == len(b.get('x', [])) == 4
        eligibility.inventory = len(a_rows) == len(b_rows) == ACCEPTED['neutral']['rows']
        for label, r in (('a', a), ('b', b)):
            setattr(eligibility, 'admission_' + label, r['success'] is True)
            residual, criterion = r.get('residual'), r.get('criterion')
            setattr(eligibility, 'residual_' + label, isinstance(residual, (int, float)) and isinstance(criterion, (int, float))
                    and math.isfinite(criterion) and criterion > 0 and 0 <= residual <= criterion)
        for key, field, quantity in (('P','pressure',Quantity.Linear),('rho','densities',Quantity.Positive),('x','composition',Quantity.Linear)):
            for j in range(len(a[key])):
                errors = []
                for e in estimates:
                    error = NumericalEstimate()
                    if e is not None and j < len(e[field]):
                        for name, value in e[field][j].items():
                            setattr(error, name, value)
                    errors.append(error)
                operands[i,key,j] = quantity, *errors, eligibility, ComparisonMode.EstimatedError
    return operands


def table(path):
    return list(csv.DictReader(path.open())) if path.stat().st_size else []


def family_differences(a_rows, b_rows):
    """The declared 73-state MEA family: row criterion and its frozen entrywise metric."""
    from epcsaft.equilibrium import (ComparisonEligibility, ComparisonMode, NumericalEstimate, Quantity,
                                      compare_equilibrium_quantity)
    estimate, eligibility = NumericalEstimate(), ComparisonEligibility()
    found = []
    quantities = {'amounts': 2, 'mole_fractions': 18, 'molar_densities': 2}
    for label, rows in (('A', a_rows), ('B', b_rows)):
        if [r['index'] for r in rows] != list(range(73)):
            found.append(dict(image=label, reason='family inventory differs from 73 ordered states'))
        for r in rows:
            if r.get('success') is not True or r.get('met') is not True or not 0 <= r.get('residual', math.inf) <= 1e-10:
                found.append(dict(image=label, row=r['index'], reason='family state unavailable or row criterion unmet'))
            for key, size in quantities.items():
                values = r.get(key, [])
                if len(values) != size or not all(math.isfinite(v) for v in values):
                    found.append(dict(image=label, row=r['index'], key=key, reason='unavailable physical quantities'))
    for a, b in zip(a_rows, b_rows):
        if any(a[k] != b[k] for k in ('index', 'loading', 'T', 'P')):
            found.append(dict(row=a['index'], reason='family declaration differs'))
        if a.get('success') is not True or b.get('success') is not True:
            continue
        for key in quantities:
            for j, (p, q) in enumerate(zip(a[key], b[key])):
                metric = abs(p - q) / max(abs(p), abs(q), 1e-14)
                if compare_equilibrium_quantity(Quantity.Linear, p, q, 1e-10 * max(abs(p), abs(q), 1e-14),
                        estimate, estimate, eligibility, ComparisonMode.Strict).judgment == 'failed':
                    found.append(dict(row=a['index'], key=key, entry=j, a=p, b=q, metric=metric))
    return found


def accepted(name, observed, expected):
    """Observed results that differ from the accepted ones."""
    return [dict(corpus=name, key=k, observed=v, accepted=expected[k]) for k, v in observed.items() if v != expected[k]]


def unmet(name, rows, success, residual, criterion):
    """Rows whose criterion is not finite and positive, and successful rows whose residual is not finite and within it."""
    def number(row, value):
        try:
            return float(value(row))
        except (KeyError, TypeError, ValueError):
            return math.nan
    found = []
    for i, r in enumerate(rows):
        c, x = number(r, criterion), number(r, lambda r: r[residual])
        if not 0 < c < math.inf or r[success] in (True, 'True') and not 0 <= x <= c:
            found.append(dict(corpus=name, row=i, reason=f'{residual} {r.get(residual)}, criterion {c}'))
    return found


def main():
    from engine_identity import prepared_python
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('prepared_a', nargs='?', help='prepared interpreter, virtual environment, or build-tree root')
    parser.add_argument('prepared_b', nargs='?')
    parser.add_argument('--collect-only', action='store_true')
    parser.add_argument('--compare-only', nargs=2, type=Path)
    parser.add_argument('--out', type=Path, default=ROOT / f'build/equilibrium-corpora/{time.strftime("%Y%m%dT%H%M%S")}')
    args = parser.parse_args()
    if args.collect_only and args.compare_only:
        parser.error('collection and comparison are separate operations')
    if not args.compare_only and not args.prepared_a:
        args.prepared_a = sys.executable
    comparison_python, comparison_env = prepared_python(args.prepared_b or args.prepared_a or sys.executable)
    if Path(os.path.abspath(sys.executable)) != comparison_python or os.name == "nt" and not sys.flags.utf8_mode:
        return subprocess.run([str(comparison_python), str(Path(__file__).resolve()), *sys.argv[1:]], env=comparison_env).returncode
    out = args.out.resolve()
    if out.is_relative_to(ROOT) and not out.is_relative_to(ROOT / 'build'):
        parser.error('--out must be outside the tracked tree (use build/)')
    out.mkdir(parents=True, exist_ok=False)
    began = time.perf_counter()
    env = {**os.environ, 'OMP_NUM_THREADS': '1', 'OPENBLAS_NUM_THREADS': '1', 'MKL_NUM_THREADS': '1',
           'PYTHONNOUSERSITE': '1', 'PYTHONPATH': ''}
    selections, interpreters, environments, identities = {}, {}, {}, {}
    if args.compare_only:
        failures, inventories = [], {}
        for label, directory in zip('AB', args.compare_only):
            directory = directory.resolve()
            failures.extend(json.loads((directory / 'collection-failures.json').read_text()))
            shutil.copytree(directory / 'A', out / label)
            identities[label] = json.loads((directory / 'environment-identities.json').read_text())['A']
            inventories[label] = json.loads((directory / 'accepted-inventories.json').read_text())['A']
            selections[label] = str(directory)
        if (json.loads((args.compare_only[0] / 'input-inventory.json').read_text()) !=
                json.loads((args.compare_only[1] / 'input-inventory.json').read_text())):
            parser.error('collected input inventories differ')
        print('Identical input inventories', flush=True)
        print(json.dumps(identities, indent=2), flush=True)
    else:
        for label, value in ([('A', args.prepared_a)] if args.collect_only else [('A', args.prepared_a), ('B', args.prepared_b)]):
            (out / label).mkdir()
            python, selected_env = prepared_python(value, env)
            identity = json.loads(subprocess.check_output([str(python), str(ROOT / 'tools/engine_identity.py')], env=selected_env))
            if not (identity['source_revision'] and (identity['conda_package'] and identity['source_archive_sha256'] or identity['wheel_sha256'] or identity['meson_configuration_sha256'] and identity['lock_sha256'])):
                parser.error(f'{label} must identify its prepared source, Meson build, and lock')
            selections[label], interpreters[label], environments[label], identities[label] = value, python, selected_env, identity
        inventories = {label: runpy.run_path(str(ROOT / 'tools/check-equilibrium-corpora'))['ACCEPTED']
                       for label, identity in identities.items()}
        if os.name == 'nt':
            for inventory in inventories.values():
                inventory['replay_work_histories'] = 'reported'
                for section, expected in REPLAY_RESULT_INVENTORIES.items():
                    inventory['replay'][section].update(expected)
        (out / 'accepted-inventories.json').write_text(json.dumps(inventories, indent=2) + '\n')
        (out / 'environment-identities.json').write_text(json.dumps(identities, indent=2) + '\n')

        # Cameretti and Gross each use every CPU; run them one at a time beside the single-process jobs.
        parallel = threading.Lock()

        def run(label, name, *command):
            with (out / label / f'{name}.log').open('w') as log, (parallel if name in ('cameretti', 'gross') else nullcontext()):
                code = subprocess.run([str(interpreters[label]), *map(str, command)], cwd=ROOT, env=environments[label],
                                      stdout=log, stderr=subprocess.STDOUT).returncode
            return None if code == 0 else f'{label} {name} exit {code} ({out / label / name}.log)'

        reference = out / 'A/matrix-reference'
        jobs = []
        for label in selections:
            d = out / label
            jobs += [(label, 'cameretti', ROOT / 'analyses/reproduction/2005-cameretti/scripts/run.py', d / 'cameretti'),
                     (label, 'gross', ROOT / 'analyses/reproduction/2002-gross/scripts/calculate.py', d / 'gross'),
                     (label, 'neutral', TPD / 'neutral.py', d / 'neutral.json')]
            jobs += [(label, f'replay-{s}', TPD / 'baseline.py', '--section', s, '--output', d / 'replay') for s in SECTIONS]
            jobs += [(label, 'mea-family', ROOT / 'analyses/2026-mea-flash-family-seed/scripts/family.py', label, d / 'mea-family.jsonl')]
        with ThreadPoolExecutor(len(jobs) + 1) as pool:
            matrix = pool.submit(run, 'A', 'matrix-reference', TPD / 'physical_comparison.py', reference)
            futures = [pool.submit(run, *job) for job in jobs]
            failures = [f.result() for f in [matrix, *futures]]
            if matrix.result() is None:
                failures += pool.map(lambda label: run(label, 'matrix', TPD / 'physical_comparison.py', out / label / 'matrix',
                                                       '--reference', reference / 'original-states.json'), selections)
        failures = [f for f in failures if f]
        for label in selections:
            current = json.loads(subprocess.check_output(
                [str(interpreters[label]), str(ROOT / 'tools/engine_identity.py')], env=environments[label]
            ))
            if current != identities[label]:
                failures.append(f'{label} Engine identity changed during corpora runs')

        if args.collect_only:
            inputs = {p.relative_to(ROOT).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()
                      for directory in ('tools', 'data/packets', 'engine/data/reference', 'analyses')
                      for p in (ROOT / directory).rglob('*') if p.is_file()
                      and not any(part in ('results', '__pycache__', '.venv') for part in p.relative_to(ROOT).parts)
                      and p.suffix in ('.py', '.json', '.csv', '.gz')}
            inputs.update({name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest() for name in RETAINED_INPUTS})
            (out / 'input-inventory.json').write_text(json.dumps(inputs, sort_keys=True, indent=2))
            (out / 'collection-failures.json').write_text(json.dumps(failures))
            print(json.dumps(dict(inputs=inputs, identities=identities, failures=failures), indent=2))
            return bool(failures)
    rows, found = [], {}

    def corpus(name, count, compare):
        try:
            counts = [count(out / label) for label in selections]
            found[name] = compare()
            rows.append((name, *counts, str(len(found[name]))))
        except (OSError, ValueError, KeyError, StopIteration) as error:
            rows.append((name, '-', '-', f'unreadable: {error}'))

    def cameretti(d):
        summary = table(d / 'cameretti/default-start-summary.csv')
        states = sum(int(r['states']) for r in summary)
        return f"{states - sum(int(r['default_failures']) for r in summary):,}/{states:,}"

    def cameretti_problems():
        found = []
        for label in selections:
            d = out / label / 'cameretti'
            summary = table(d / 'default-start-summary.csv')
            states = sum(int(r['states']) for r in summary)
            found += accepted(f'{label} Cameretti', dict(
                states=states, default_successes=states - sum(int(r['default_failures']) for r in summary),
                declared_all_succeeded=all(r['declared_all_succeeded'] == 'True' for r in summary)), ACCEPTED['cameretti'])
            found += [dict(corpus=f'{label} Cameretti', file=f, reason='no rows') for f in camerettis
                      if f != 'default-start-failures' and not table(d / f'{f}.csv')]
            found += [dict(corpus=f'{label} Cameretti', reason='criterion violation', **r)
                      for r in table(d / 'criterion-violations.csv')]
            found += unmet(f'{label} Cameretti band', summary, 'declared_all_succeeded', 'declared_max_residual',
                           lambda r: r['declared_max_criterion'])
        return found + [dict(file=f, **x) for f in camerettis for x in differences(
            table(out / f'A/cameretti/{f}.csv'), table(out / f'B/cameretti/{f}.csv'))]

    camerettis = ('default-start-summary', 'default-start-failures', 'table-5', 'figure-lines', 'figure-points',
                  'activity-298K', 'water', 'table-5-kcl-misprint')
    corpus('Cameretti 2005 default start', cameretti, cameretti_problems)

    gross = lambda d: table(d / 'gross/default-start-comparisons.csv')

    def gross_problems():
        found = []
        for label in selections:
            tolerance = json.loads((out / label / 'gross/calculation.json').read_text())['row_tolerance']
            found += accepted(f'{label} Gross', dict(rows=len(gross(out / label)), failed_lines=[
                i + 2 for i, r in enumerate(gross(out / label)) if r['success'] != 'True']), ACCEPTED['gross'])
            found += unmet(f'{label} Gross', gross(out / label), 'success', 'residual', lambda r: tolerance)
        return found + differences(gross(out / 'A'), gross(out / 'B'), GROSS_REPORTED)
    corpus('Gross 2002 default start', lambda d: f"{sum(r['success'] == 'True' for r in gross(d))}/{len(gross(d))}",
           gross_problems)

    neutral = lambda d: json.loads((d / 'neutral.json').read_text())['rows']

    def neutral_problems():
        found = []
        for label in selections:
            successes = {}
            for r in neutral(out / label):
                successes.setdefault(r['T'], [])  # every swept temperature, so a refused one reads []
                if r['success'] is True:
                    successes[r['T']].append(r['P0'])
            found += accepted(f'{label} neutral', dict(rows=len(neutral(out / label)), successes=successes), ACCEPTED['neutral'])
            found += unmet(f'{label} neutral', neutral(out / label), 'success', 'residual', lambda r: r['criterion'])
        a_rows, b_rows = neutral(out / 'A'), neutral(out / 'B')
        operands, comparisons = neutral_comparison_operands(a_rows, b_rows), []
        found += differences(a_rows, b_rows, operands=operands, comparisons=comparisons)
        (out / 'neutral-comparisons.json').write_text(json.dumps(comparisons, indent=2) + '\n')
        return found
    corpus('neutral methane/ethane sweep', lambda d: f"{sum(r['success'] for r in neutral(d))}/{len(neutral(d))}",
           neutral_problems)

    matrix = lambda d: table(d / 'matrix/comparisons.csv')

    def matrix_problems():
        found = []
        keys = {label: [(r['case'], r['lane'], r['N']) for r in matrix(out / label)] for label in selections}
        for label in selections:
            found += accepted(f'{label} matrix', dict(rows=len(set(keys[label])), passes=sum(
                r['passes'] == 'True' for r in matrix(out / label))), ACCEPTED['matrix'])
            found += [dict(corpus=f'{label} matrix', key=k, reason='duplicate') for k in set(keys[label])
                      if keys[label].count(k) > 1]
        if keys['A'] != keys['B']:
            found.append(dict(corpus='matrix', reason='case/lane/feed inventories differ'))
        return found + differences(matrix(out / 'A'), matrix(out / 'B'), MATRIX_REPORTED)
    corpus('#243 matrix', lambda d: f"{sum(r['passes'] == 'True' for r in matrix(d))}/{len(matrix(d))}", matrix_problems)

    def replay():
        rules = runpy.run_path(str(TPD / 'replay_compare.py'))
        if subprocess.run([sys.executable, TPD / 'replay_compare.py', out / 'A/replay', out / 'B/replay',
                           out / 'replay-compare.json'], stdout=subprocess.DEVNULL).returncode:
            raise ValueError('replay_compare.py failed')
        found = [f for section in json.loads((out / 'replay-compare.json').read_text()).values() for f in section['failures']]
        for label in selections:
            for s in SECTIONS:
                rows = table(out / label / f'replay/{s}.csv')
                if inventories[label].get('replay_work_histories') == 'reported':
                    rows = [r for r in rows if rules['base'](r['quantity']) not in rules['WORK']]
                true = lambda q: sum(r['quantity'] == q and r['value'] == 'True' for r in rows)
                keys = '\n'.join(sorted(f"{r['case']},{r['quantity']}" for r in rows))
                found += accepted(f'{label} replay {s}', dict(
                    rows=len(rows), cases=len({r['case'] for r in rows}), success=true('success'),
                    requested_tolerance_met=true('requested_tolerance_met'),
                    keys=hashlib.sha256(keys.encode()).hexdigest()[:16]), inventories[label]['replay'][s])
        return found
    corpus('replay rows (4 sections)', lambda d: f"{sum(len(table(d / f'replay/{s}.csv')) for s in SECTIONS):,}", replay)

    family = lambda d: [json.loads(line) for line in (d / 'mea-family.jsonl').read_text().splitlines()]
    corpus('MEA flash family', lambda d: f"{sum(r['success'] for r in family(d))}/{len(family(d))}",
           lambda: family_differences(family(out / 'A'), family(out / 'B')))

    (out / 'differences.json').write_text(json.dumps(found, indent=2, default=str) + '\n')
    header = ('corpus', 'A', 'B', 'problems')
    widths = [max(len(str(r[i])) for r in [header, *rows]) for i in range(4)]
    for r in [header, *rows]:
        print('  '.join(str(c).ljust(w) for c, w in zip(r, widths)))
    for failure in failures:
        print('FAILED', failure)
    print(f'prepared A={selections["A"]} B={selections["B"]}; details {out}/differences.json; {time.perf_counter() - began:.0f} s')
    return 1 if failures or any(found.get(r[0]) for r in rows) or any(r[1] == '-' for r in rows) else 0


if __name__ == '__main__':
