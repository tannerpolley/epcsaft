def count_keys(case):
    return F1_COUNTS if case in FROZEN else COUNTS


def quantities(case):
    return F1_VALUES if case in FROZEN else PHYSICAL


def equilibrium_iterations(trace):
    # Callback iteration ordinals include restoration; zero starts each driver attempt.
    last, total = {}, 0
    for event in trace.events:
        if event.name != 'ipopt_iteration':
            continue
        if event.iteration == 0:
            last[event.span] = 0
        elif event.span not in last or event.iteration < last[event.span]:
            raise RuntimeError('F1 equilibrium iteration observations missing or unordered')
        total += event.iteration - last[event.span]
        last[event.span] = event.iteration
    for index, span in enumerate(trace.spans):
        if span.name == 'solve_equilibrium' and index not in last and (
                span.convergence is None or span.convergence.iterations != 0):
            raise RuntimeError('F1 equilibrium iteration observations missing')
    return total


class NotComparable(Exception):
    """The arm's Engine lacks a type, enum member or field that a frozen fixture sets (#602)."""


def frozen_result(case, operation):
    import epcsaft
    from epcsaft import _core
    fixture = FROZEN[case]
    data, rows, width, physical = fixture['data'], fixture['rows'], fixture['width'], fixture['physical']

    def decode(value):
        if isinstance(value, list):
            return [decode(v) for v in value]
        if not isinstance(value, dict):
            return value
        name = value.get('enum', value.get('type'))
        if not hasattr(_core, name):
            raise NotComparable(f'lacks type {name}')
        if 'enum' in value:
            if not hasattr(getattr(_core, name), value['name']):
                raise NotComparable(f"lacks enum member {name}.{value['name']}")
            return getattr(getattr(_core, name), value['name'])
        cls = getattr(_core, name)
        # Bound properties are class attributes, so this covers both construction paths below.
        lacking = [key for key in value['fields'] if not hasattr(cls, key)]
        if lacking:
            raise NotComparable(f'lacks field {name}.{lacking[0]}')
        fields = {k: decode(v) for k, v in value['fields'].items()}
        try:
            obj = cls()
        except TypeError:
            return cls(**fields)
        for key, field in fields.items():
            setattr(obj, key, field)
        return obj

    parameters = epcsaft.Parameters.from_mapping(data['parameters'])
    coordinates, observations, thermal = (decode(data[k]) for k in ('coordinates', 'observations', 'thermochemistry'))
    if operation == 'fit':
        controls = _core.FitControls(maximum_iterations=40, maximum_elapsed_time_seconds=120, workers=0)
        children = resource.getrusage(resource.RUSAGE_CHILDREN)
        child_cpu = children.ru_utime + children.ru_stime
        clock, cpu = time.perf_counter(), time.process_time()
        result = _core.fit(parameters._native, thermal, coordinates, observations, data['weights'], controls)
        seconds = time.perf_counter() - clock
        children = resource.getrusage(resource.RUSAGE_CHILDREN)
        cpu_seconds = time.process_time() - cpu + children.ru_utime + children.ru_stime - child_cpu
        if result.status != 'converged' or not result.usable or result.trial_failures or len(result.statuses) != rows or any(
                s != _core.ObservationStatus.Available for s in result.statuses):
            raise RuntimeError(f'F1 fit: {result.message}; trial failures {result.trial_failures}')
        reply = {k: getattr(result, k) for k in ('iterations', 'residual_evaluations', 'jacobian_evaluations',
                                               'initial_cost', 'final_cost', 'status', 'message')}
        reply.update(seconds=seconds, cpu_seconds=cpu_seconds, workers=os.cpu_count(),
                     rows=[dict(point=F1, **{k: getattr(result, k) for k in FIT_VALUES})])
        return reply
    chart = _core.CoordinateSet()
    chart.coordinates = coordinates
    point = chart.start(parameters._native, observations, thermal)
    clock, cpu = time.perf_counter(), time.process_time()
    with epcsaft.trace(diagnostics=False) as capture:
        result = _core.evaluate_observations(parameters._native, coordinates, point, [], observations, thermal)
    cpu_seconds, seconds = time.process_time() - cpu, time.perf_counter() - clock
    trace = capture.trace
    if trace.incomplete or any(s != _core.ObservationStatus.Available for s in result.statuses):
        raise RuntimeError(f'{case} evaluation incomplete or unavailable')
    spans = trace.spans
    counts = dict(reference_computations=sum(e.name == 'reference_cache_miss' for e in trace.events),
                  reference_columns=sum(s.name == 'reference_column' for s in spans),
                  density_solves=sum(s.name == 'solve_density' for s in spans),
                  equilibrium_iterations=equilibrium_iterations(trace))
    if not all(counts.values()):
        raise RuntimeError(f'{case} work observations missing: {counts}')
    row = dict(point=case, **counts, **{k: getattr(result, k) for k in F1_VALUES},
               raw_rows=0, classified_rows=0, success=True, criterion_met=True)
    if (len(row['predictions']) != rows or len(row['gradient']) != rows * physical
            or any(len(row[k]) != rows * width for k in F1_VALUES[2:])):
        raise RuntimeError(f'{case} output dimensions differ')
    if not all(math.isfinite(v) for key in F1_VALUES for v in row[key]):
        raise RuntimeError(f'{case} output nonfinite')
    central = sum(s.name == 'evaluate' and s.parent is not None and spans[s.parent].name == 'reference_column'
                  for s in spans)
    return dict(seconds=seconds, cpu_seconds=cpu_seconds, reference_taylor_evaluations=central, rows=[row])


def unloaded_declaration():
    """Reuse #261's declaration exactly, as in #272's unloaded_input.py probe.

    Extract only its inputs and Problem, without running solves or caloric actions.
    This keeps the existing test as the single owner of the declaration.
    """
    source = ROOT / 'engine/tests/equilibrium/test_trace_reliability.py'
    tree = ast.parse(source.read_text())
    items = []
    for node in tree.body:
        if isinstance(node, ast.Import) and all(x.name in ('json', 'math') for x in node.names):
            items.append(node)
        elif isinstance(node, ast.ImportFrom) and node.module in (
                'pathlib', 'typing', 'epcsaft', 'epcsaft.equilibrium'):
            items.append(node)
        elif isinstance(node, ast.Assign) and isinstance(node.targets[0], ast.Name) and node.targets[0].id == '_MEA':
            items.append(node)
        elif isinstance(node, ast.FunctionDef) and node.name == '_mea_mapping':
            items.append(node)
    function = next(x for x in tree.body if isinstance(x, ast.FunctionDef)
                    and x.name == 'test_nominally_unloaded_mea_resolves_trace_ion_stationarity')
    body = []
    for node in function.body:
        if isinstance(node, ast.FunctionDef) and node.name == 'actions':
            break
        if isinstance(node, ast.FunctionDef) and node.name == 'solve':
            # Its first statement declares the Problem. No native solve here.
            node.body = [node.body[0], ast.parse('return problem').body[0]]
        body.append(node)
    body.append(ast.parse('return model, solve(353.15)').body[0])
    function.name = 'declaration'
    function.args = ast.arguments(posonlyargs=[], args=[], kwonlyargs=[], kw_defaults=[], defaults=[])
    function.body, function.decorator_list, function.returns = body, [], None
    items.append(function)
    namespace = {'__file__': str(source)}
    exec(compile(ast.fix_missing_locations(ast.Module(body=items, type_ignores=[])), str(source), 'exec'), namespace)
    return namespace['declaration']()


def worker():
    # Native libraries write to fd 1. Keep their diagnostics off the JSON pipe.
    replies = os.fdopen(os.dup(1), 'w')
    os.dup2(2, 1)
    import epcsaft
    from epcsaft import equilibrium as eq
    from engine_identity import loaded_identity
    sys.path.insert(0, str(ROOT / 'analyses/2026-tpd-phase-discovery/scripts'))
    import baseline as b
    declarations = {name: (model, problem) for name, model, problem in b.declared_cases() if name in ORDINARY}
    fixed = sys.modules['run_fixed_settler']
    kh_model = epcsaft.Mixture(epcsaft.Parameters.from_json(b.KH_PACKET, components=fixed.COMPONENTS))
    sequence = [(f'khudaida/point-{i}', kh_model, fixed.engine_problem(fixed.feed_rows()[i])) for i in range(1, 9)]
    unloaded = unloaded_declaration()
    for line in sys.stdin:
        request = json.loads(line)
        if request['case'] == '__identity__':
            reply = loaded_identity()
        elif request['case'] in FROZEN:
            try:
                reply = frozen_result(request['case'], request.get('operation', 'evaluation'))
                reply.update(nice=os.getpriority(os.PRIO_PROCESS, 0), affinity=sorted(os.sched_getaffinity(0)))
            except NotComparable as error:
                reply = {'not_comparable': str(error)}
        elif request['case'] == 'starts':
            reply = {}
            for name, (model, problem) in declarations.items():
                result = eq.solve_equilibrium(model, problem)
                if not result.success or result.requested_tolerance_met is not True:
                    raise RuntimeError(f'{name}: {result.message}')
                reply[name] = result.coordinates
        else:
            name = request['case']
            if name == 'khudaida/sequential-8':
                calls = sequence
            elif name == 'mea-nominally-unloaded/353.15-K':
                calls = [(name, *unloaded)]
            else:
                base, mode = name.rsplit('/', 1)
                calls = [(name, *declarations[base])]
            previous, rows, elapsed = None, [], 0.0
            for point, model, problem in calls:
                seed = None
                if name.endswith('/accepted'):
                    seed = eq.EquilibriumStart()
                    seed.coordinates = request['starts'][base]
                begun = time.perf_counter_ns()
                if seed is not None:
                    attempts = eq.solve_equilibrium_starts(model, problem, [seed], eq.EquilibriumWorkLimits())
                    result = attempts.results[0]
                else:
                    result = eq.solve_equilibrium(model, problem, previous)
                elapsed += (time.perf_counter_ns() - begun) / 1e9
                if result is None:
                    raise RuntimeError(f'{point}: no state returned: {attempts.causes}')
                row = {key: getattr(result, key) for key in (*COUNTS, *PHYSICAL)} | {key: v if isinstance(v := getattr(result, key), list) else [v] for key in ('temperature', 'pressure')}
                row.update(point=point, success=result.success, criterion_met=result.requested_tolerance_met,
                           raw_rows=max(map(abs, result.residuals)), classified_rows=max(map(abs, result.classified_residuals)),
                           message=result.message)
                rows.append(row)
                if not result.success or result.requested_tolerance_met is not True:
                    raise RuntimeError(f'{point}: {result.message}; residuals={result.residuals}')
                if not all(row[key] and all(map(math.isfinite, row[key])) for key in PHYSICAL):
                    raise RuntimeError(f'{point}: empty or nonfinite physical state')
                previous = result
            reply = dict(seconds=elapsed, rows=rows, nice=os.getpriority(os.PRIO_PROCESS, 0),
                         affinity=sorted(os.sched_getaffinity(0)), engine=str(epcsaft.__file__))
        print(json.dumps(reply, allow_nan=False), file=replies, flush=True)


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def write_csv(path, rows):
    with path.open('w', newline='') as stream:
        writer = csv.DictWriter(stream, fieldnames=list(dict.fromkeys(k for row in rows for k in row)), lineterminator='\n')
        writer.writeheader()
        writer.writerows(rows)


def scaled_differences(a, b, case=None, quantity=None):
    """abs(A-B) over the quantity's largest magnitude in this state: 1e-10 relative at its scale,
    with that scale as the absolute floor for near-zero entries (CODING_STANDARDS.md)."""
    if case in FROZEN:
        fixture = FROZEN[case]
        data, physical = fixture['data'], fixture['physical']
        # Physical columns map to coordinates only when each coordinate moves one parameter (F1); otherwise
        # a row's physical derivatives take their largest magnitude as the floor.
        mapped = physical == fixture['width']
        floors = [1.0] * len(a)
        for i in range(len(a)):
            if quantity == 'physical':
                floors[i] = data['coordinates'][i]['fields']['scale']
            elif quantity in (*F1_VALUES, 'physical_jacobian'):
                physical_columns = quantity in ('gradient', 'physical_jacobian')
                row, column = (i, 0) if quantity == 'predictions' else divmod(i, physical if physical_columns else fixture['width'])
                floors[i] = data['observations'][row]['fields']['scale']
                if physical_columns and mapped:
                    floors[i] /= data['coordinates'][column]['fields']['scale']
                elif physical_columns:
                    floors[i] = max(map(abs, (*a[row * physical:(row + 1) * physical],
                                              *b[row * physical:(row + 1) * physical]))) or 1.0
                if quantity == 'residual_optimizer_gradient':
                    floors[i] = 1.0
        return [abs(x-y) / max(abs(x), abs(y), floor) for x, y, floor in zip(a, b, floors, strict=True)]
    scale = max(map(abs, (*a, *b)), default=0.0)
    return [abs(x - y) / scale if scale else 0.0 for x, y in zip(a, b, strict=True)]


def physical_difference(a, b, keys=PHYSICAL):
    maximum = (0.0, None)
    for left, right in zip(a['rows'], b['rows'], strict=True):
        if left['point'] != right['point']:
            raise RuntimeError('physical-state point order differs')
        for key in keys:
            if not left[key] or not right[key] or not all(math.isfinite(v) for v in (*left[key], *right[key])):
                raise RuntimeError(f'{left["point"]}: empty or nonfinite {key}')
            for index, difference in enumerate(scaled_differences(left[key], right[key], left['point'], key)):
                if difference > maximum[0]:
                    maximum = (difference, (left['point'], key, index, left[key][index], right[key][index]))
    return maximum


def gate(work_rows, state_rows, expect_change=False):
    """Print every work-count change, missing state and the worst state row; return the failures.

    Rows are retained work.csv and states.csv rows (numbers or their CSV text).
    """
    counts, failures = {}, []
    for row in work_rows:
        counts.setdefault((row['case'], row['point']), {'A': set(), 'B': set()})[row['wheel']].add(
            tuple(int(row[k]) for k in count_keys(row['case'])))
    for (case, point), seen in counts.items():
        if len(seen['A'] | seen['B']) > 1:
            keys = count_keys(case)
            line = f"WORK CHANGE {point}: A {sorted(seen['A'])} B {sorted(seen['B'])} ({'/'.join(keys)})"
            print(line, flush=True)
            if case.rsplit('/', 1)[0] in ORDINARY and not expect_change:
                failures.append(line)
            if case in FROZEN and (len(seen['A']) != 1 or len(seen['B']) != 1 or (not expect_change
                    and any(b > a for a, b in zip(next(iter(seen['A'])), next(iter(seen['B'])), strict=True)))):
                failures.append(line)
    values = {}
    for row in state_rows:
        values.setdefault((row['case'], row['sample'], row['point'], row['quantity']), {'A': [], 'B': []})[
            row['wheel']].append(float(row['value']))
    # Equivalence needs states: every case and sample solved by both wheels at the same points,
    # each point with every physical quantity, and no quantity whose entry counts differ.
    points, missing = {}, []
    for row in work_rows:
        points.setdefault((row['case'], row['sample']), {'A': [], 'B': []})[row['wheel']].append(row['point'])
    for case in CASES:
        for sample in {'warmup'} | {sample for name, sample in points
                                    if (name == case if case in FROZEN else name not in FROZEN)}:
            seen = points.get((case, sample), {'A': [], 'B': []})
            if not seen['A'] or seen['A'] != seen['B']:
                missing.append(f"MISSING STATE {case} {sample}: points A {seen['A']} B {seen['B']}")
            missing.extend(f'MISSING STATE {case} {sample} {point} {quantity}'
                           for point in seen['A'] for quantity in quantities(case) if (case, sample, point, quantity) not in values)
    missing.extend(f"MISSING STATE {key}: A {len(pair['A'])} B {len(pair['B'])} entries"
                   for key, pair in values.items() if len(pair['A']) != len(pair['B']))
    for line in missing:
        print(line, flush=True)
    failures.extend(missing)
    worst = (0.0, None)
    for key, pair in values.items():
        if len(pair['A']) != len(pair['B']):
            continue
        try:
            difference, detail = physical_difference(
                {'rows': [dict(point=key[2], **{key[3]: pair['A']})]},
                {'rows': [dict(point=key[2], **{key[3]: pair['B']})]}, (key[3],))
        except RuntimeError as error:
            failures.append(f'INVALID STATE {key}: {error}')
            continue
        if difference > worst[0]:
            worst = (difference, (*key[:2], *detail))
    line = f'WORST STATE ROW {worst[0]:.3g} (case, sample, point, quantity, index, A, B): {worst[1]}'
    print(line, flush=True)
    if worst[0] > STATE_TOLERANCE:
        failures.append(line)
    return failures


def work(result):
    keys = count_keys(result['rows'][0]['point'])
    return {key: sum(row[key] for row in result['rows']) for key in keys}


def evaluation(result):
    return dict(work=work(result), **{k: result[k] for k in ('seconds', 'cpu_seconds', 'reference_taylor_evaluations')})


def ceilings(case, evaluations, fits=(), control=False):
    """Serial CPU ceilings of a frozen fixture and F1's fit ceilings; evaluations are evaluation() dicts.
    In an A=A control both arms are one prepared image, so neither is the candidate."""
    failures, fits = [], dict(fits)
    if control and set(evaluations) != set('AB'):
        return [f'{case} A=A control needs both serial evaluations']
    frozen = FROZEN[case]['identity']['frozen']
    ceiling = 1.25 * frozen['serial_cpu_seconds']
    # A baseline or control arm measures the host only when it does the frozen work; B is always held (#595).
    host = {label for label, result in evaluations.items() if (label == 'A' or control) and result['work'] == frozen['work']}
    if any(evaluations[label]['cpu_seconds'] > ceiling for label in host):
        raise RuntimeError('invalid host measurement: rerun on a quieter host')
    for label, result in evaluations.items():
        print(f'{case} {label}: serial CPU {result["cpu_seconds"]:.6f} s / ceiling {ceiling:.6f} s; '
              f'wall {result["seconds"]:.6f} s; central Taylor {result["reference_taylor_evaluations"]}', flush=True)
        held = label in host or (label == 'B' and not control)
        if (held and not result['cpu_seconds'] <= ceiling or not result['cpu_seconds'] > 0
                or not math.isfinite(result['seconds']) or result['seconds'] <= 0):
            failures.append(f'{case} {label} serial CPU exceeds {ceiling:.6f} s or is invalid')
    for label, result in fits.items():
        print(f'F1 {label}: fit wall {result["seconds"]:.6f} s / ceiling 120 s; '
              f'critical-path CPU {result["critical_cpu_seconds"]:.6f} s', flush=True)
        if (not 0 < result['seconds'] <= 120 or result['status'] != 'converged'
                or not math.isfinite(result['critical_cpu_seconds']) or result['critical_cpu_seconds'] <= 0):
            failures.append(f'F1 {label} fit failed, exceeds 120 s or has invalid CPU evidence')
    return failures


def fit_cpu(directory, result):
    rows = [dict(zip(('evaluation', 'worker', 'jacobian', 'cpu_seconds'), row, strict=True))
            for path in directory.glob('*.csv') for row in csv.reader(path.open())]
    expected = result['residual_evaluations'] + result['jacobian_evaluations']
    seen = {(int(r['evaluation']), int(r['worker'])) for r in rows}
    if len(seen) != len(rows) or seen != {(e, w) for e in range(1, expected + 1) for w in range(result['workers'])}:
        raise RuntimeError('F1 fit CPU records missing or duplicated')
    if any(not math.isfinite(float(r['cpu_seconds'])) or float(r['cpu_seconds']) <= 0 for r in rows):
        raise RuntimeError('F1 fit CPU record invalid')
    result['critical_cpu_seconds'] = sum(max(float(r['cpu_seconds']) for r in rows if int(r['evaluation']) == e)
                                         for e in range(1, expected + 1))
    result['total_compute_cpu_seconds'] = sum(float(r['cpu_seconds']) for r in rows)


def main():
    from engine_identity import prepared_python
    parser = argparse.ArgumentParser(description=__doc__, epilog=(
        'Work counts are the primary comparison. Change = 100*(B/A-1); negative is faster. '
        'Each pair includes AB and BA blocks. Times cover solve calls only, after a complete warmup. '
        'Exit is nonzero when a case-6 or case-7 work count changes (unless --expect-change) or a state '
        'differs beyond 1e-10 of its quantity scale. F1 work increases and absolute CPU/wall ceilings also fail. '
        'The sequential case resets to cold point 1 and reuses each result at the next point.'))
    parser.add_argument('prepared_A', type=Path, help='prepared interpreter, virtual environment, or build-tree root')
    parser.add_argument('prepared_B', type=Path)
    parser.add_argument('--pairs', type=int, default=1, help='counterbalanced pairs per case; more only for timing claims (default: 1)')
    parser.add_argument('--out', type=Path, default=ROOT / time.strftime('build/time-key-solves/%Y%m%dT%H%M%S'),
                        help='new or empty result directory (default: timestamped under build/time-key-solves)')
    parser.add_argument('--expect-change', action='store_true',
                        help='report intended work changes without failing; numerical values and ceilings still gate')
    parser.add_argument('--cpu', type=int, help='serial-sample CPU; full fits retain controller affinity')
    parser.add_argument('--fit', action='store_true', help='also run one F1 fit per environment with native default workers')
    parser.add_argument('--control', type=Path, help='passing A=A --fit summary from this host and prepared A image')
    args = parser.parse_args()
    if args.pairs < 1:
        parser.error('--pairs must be positive')
    out = args.out.resolve()
    if out.exists() and any(out.iterdir()):
        parser.error('--out must be new or empty')
    out.mkdir(parents=True, exist_ok=True)
    begun = time.perf_counter()
    if os.getpriority(os.PRIO_PROCESS, 0) > 10:
        parser.error('inherited niceness exceeds 10; cannot lower it without new authority')
    cpu = args.cpu if args.cpu is not None else min(os.sched_getaffinity(0))
    if cpu not in os.sched_getaffinity(0):
        parser.error('--cpu must be in the controller affinity')
    env = {**os.environ, 'OMP_NUM_THREADS': '1', 'OPENBLAS_NUM_THREADS': '1', 'MKL_NUM_THREADS': '1',
           'PYTHONNOUSERSITE': '1', 'PYTHONPATH': ''}
    processes, environments, identities = {}, {}, {}
    interpreters = {}
    work_rows, state_rows, pair_rows, start_rows = [], [], [], []
    summary = dict(environments={},
                   source_commit=subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
                   cpu=cpu, nice=10, threads=1, host=platform.node(), pairs=args.pairs, warmups=1,
                   time_boundary='sum of equilibrium call wall times; preparation, imports and result reading excluded',
                   change_percent='100*(B_seconds/A_seconds-1)',
                   state_difference='abs(A-B)/largest magnitude of that quantity in the returned state; gate 1e-10; declared phase order',
                   evaluation_meaning='native Engine evaluations, including exact polish; not every EOS evaluation',
                   limits='shared-host timing; declared local states only; no physical validation or global stability')

    def call(label, case, starts=None, operation='evaluation'):
        process = processes[label]
        process.stdin.write(json.dumps(dict(case=case, starts=starts, operation=operation)) + '\n')
        process.stdin.flush()
        line = process.stdout.readline()
        if not line:
            raise RuntimeError(f'{label} worker exited while running {case}')
        return json.loads(line)

    def retain(label, case, sample, result):
        if result['nice'] != 10 or (sample != 'timer' and result['affinity'] != [cpu]):
            raise RuntimeError(f'{label}: timing controls differ: {result}')
        for row in result['rows']:
            work_rows.append(dict(wheel=label, case=case, sample=sample, point=row['point'],
                                  **{key: row[key] for key in count_keys(case)}, raw_rows=row['raw_rows'],
                                  classified_rows=row['classified_rows'], success=row['success'],
                                  criterion_met=row['criterion_met']))
            for key in quantities(case):
                state_rows.extend(dict(wheel=label, case=case, sample=sample, point=row['point'],
                                       quantity=key, index=i, value=value) for i, value in enumerate(row[key]))

    def stop(label):
        process = processes[label]
        process.stdin.close()
        try:
            process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            process.terminate()
            process.wait(timeout=10)
        process.stdout.close()

    def launch(label, profile=None):
        selected_env = dict(environments[label])
        selected_env.pop('EPCSAFT_FIT_CPU_PROFILE', None)
        affinity = [cpu]
        if profile is not None:
            profile.mkdir()
            selected_env['EPCSAFT_FIT_CPU_PROFILE'] = str(profile)
            affinity = sorted(os.sched_getaffinity(0))
        processes[label] = subprocess.Popen(['taskset', '-c', ','.join(map(str, affinity)), 'nice', '-n',
            str(max(0, 10 - os.getpriority(os.PRIO_PROCESS, 0))), str(interpreters[label]),
            str(Path(__file__).resolve()), '--worker'], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            text=True, cwd=ROOT, env=selected_env)
        if call(label, '__identity__') != identities[label]:
            raise RuntimeError(f'{label} worker loaded a different Engine image than its prepared identity')

    try:
        for label, selected in (('A', args.prepared_A), ('B', args.prepared_B)):
            python, selected_env = prepared_python(selected, env)
            identity = json.loads(subprocess.check_output([str(python), str(ROOT / 'tools/engine_identity.py')], env=selected_env))
            if not identity['source_revision'] or not identity['meson_configuration_sha256'] or not identity['lock_sha256']:
                parser.error(f'{label} must identify its prepared source, Meson build, and lock')
            identities[label], environments[label] = identity, selected_env
            interpreters[label] = python
            summary['environments'][label] = dict(path=str(selected), **identity)
            launch(label)
        starts = call('A', 'starts')
        start_rows = [dict(case=case, coordinate=i, value=value) for case, values in starts.items() for i, value in enumerate(values)]
        baseline = {}
        comparisons, not_comparable = {}, []
        print('WORK COUNTS FIRST: iterations / evaluations / Hessian calls (A versus B)', flush=True)
        for case in CASES:
            for attempt in range(1, 4 if case in FROZEN else 2):
                baseline[case] = {label: call(label, case, starts) for label in ('A', 'B')}
                causes = {label: reply['not_comparable'] for label, reply in baseline[case].items() if 'not_comparable' in reply}
                if causes:
                    break
                for label in ('A', 'B'):
                    retain(label, case, 'warmup' if attempt == 1 else f'serial-{attempt}', baseline[case][label])
                if case not in FROZEN:
                    break
                summary.setdefault('serial_attempts', {}).setdefault(case, []).append({
                    label: baseline[case][label]['cpu_seconds'] for label in ('A', 'B')})
                try:
                    ceilings(case, {'A': evaluation(baseline[case]['A'])})
                    break
                except RuntimeError:
                    if attempt == 3:
                        raise
                    print(f'{case} serial pair {attempt}: invalid host measurement; retrying pair', flush=True)
            if causes:
                # Neither arm's rows are retained or compared; the case is a named gate failure (#602).
                summary.setdefault('not_comparable', {})[case] = causes
                for label, cause in causes.items():
                    not_comparable.append(f'NOT COMPARABLE {case}: {label} {cause}')
                    print(not_comparable[-1], flush=True)
                continue
            a, b = baseline[case]['A'], baseline[case]['B']
            equal = all(tuple(left[k] for k in count_keys(case)) == tuple(right[k] for k in count_keys(case))
                        for left, right in zip(a['rows'], b['rows'], strict=True))
            comparisons[case] = dict(work_A=work(a), work_B=work(b), work_identical=equal,
                                     max_state_difference=physical_difference(a, b, quantities(case))[0])
            print(f'{case}: {tuple(work(a).values())} vs {tuple(work(b).values())} '
                  f'{"IDENTICAL" if equal else "WORK DIFFERENCE"}', flush=True)
            if case == 'khudaida/sequential-8':
                for left, right in zip(a['rows'], b['rows'], strict=True):
                    print(f"  {left['point']}: {tuple(left[k] for k in COUNTS)} vs {tuple(right[k] for k in COUNTS)}", flush=True)
        print('PAIRED WALL TIME: each pair contains AB and BA; fixed CPU and niceness', flush=True)
        for pair in range(1, args.pairs + 1):
            for case in (case for case in CASES if case not in FROZEN):
                # Alternate which block comes first, even when --pairs is odd.
                orders = ('AB', 'BA') if pair % 2 else ('BA', 'AB')
                for order in orders:
                    load = os.getloadavg()
                    results = {}
                    for label in order:
                        results[label] = call(label, case, starts)
                        retain(label, case, f'{pair}-{order}', results[label])
                        ref = baseline[case][label]
                        if [tuple(r[k] for k in COUNTS) for r in results[label]['rows']] != [tuple(r[k] for k in COUNTS) for r in ref['rows']]:
                            comparisons[case]['work_identical'] = False
                            print(f'WORK DIFFERENCE: {case} environment {label} sample {pair}-{order}', flush=True)
                    a, b = results['A'], results['B']
                    difference = physical_difference(a, b)[0]
                    comparisons[case]['max_state_difference'] = max(comparisons[case]['max_state_difference'], difference)
                    pair_rows.append(dict(case=case, pair=pair, order=order, A_seconds=a['seconds'], B_seconds=b['seconds'],
                                          change_percent=100 * (b['seconds'] / a['seconds'] - 1),
                                          load_1=load[0], load_5=load[1], load_15=load[2], max_state_difference=difference))
                print(f'pair {pair}/{args.pairs} {case}: AB/BA complete; load={load}', flush=True)
        for label in ('A', 'B'):
            if call(label, '__identity__') != identities[label]:
                raise RuntimeError(f'{label} Engine image changed during key-solve comparison')
        same_image = (identities['A']['extension_sha256'], identities['A']['native_library_sha256']) == \
                     (identities['B']['extension_sha256'], identities['B']['native_library_sha256'])
        for case, comparison in comparisons.items():
            if case in FROZEN:
                continue
            rows = [row for row in pair_rows if row['case'] == case]
            # Each balanced observation is the mean of its AB and BA relative changes.
            changes = [statistics.mean(row['change_percent'] for row in rows if row['pair'] == pair)
                       for pair in range(1, args.pairs + 1)]
            median = statistics.median(changes)
            comparison.update(median_change_percent=median, range_percent=[min(changes), max(changes)],
                              mad_percent=statistics.median(abs(value - median) for value in changes),
                              median_A_seconds=statistics.median(row['A_seconds'] for row in rows),
                              median_B_seconds=statistics.median(row['B_seconds'] for row in rows))
            comparison['zero_within_spread'] = abs(median) <= max(abs(value - median) for value in changes)
            print(f'{case}: median {median:+.3f}%, range [{min(changes):+.3f}, {max(changes):+.3f}]%, '
                  f"MAD {comparison['mad_percent']:.3f}%; state Δ={comparison['max_state_difference']:.3g}", flush=True)
        same_prepared = identities['A'] == identities['B']
        summary['same_prepared_environment'] = same_prepared
        summary.update(cases=comparisons, identical_engine_images=same_image, expect_change=args.expect_change,
                       gate_failures=gate(work_rows, state_rows, args.expect_change) + not_comparable)
        for case in FROZEN:
            if case in summary.get('not_comparable', {}):
                continue
            comparisons[case].update(median_A_seconds=baseline[case]['A']['seconds'],
                                     median_B_seconds=baseline[case]['B']['seconds'],
                                     evaluations={label: evaluation(result) for label, result in baseline[case].items()})
            summary['gate_failures'].extend(ceilings(case, comparisons[case]['evaluations'], control=same_prepared))
        if args.fit and F1 not in summary.get('not_comparable', {}):
            f1 = comparisons[F1]
            control = json.loads(args.control.read_text()) if args.control else None
            if (args.control or not same_prepared) and (not control or control.get('gate_failures') != [] or control.get('error')
                    or not control.get('identical_engine_images') or control.get('host') != summary['host']
                    or any(control['environments']['A'][key] != control['environments']['B'][key]
                           for key in ('source_root', 'source_revision', 'source_diff_sha256', 'interpreter',
                                       'extension_sha256', 'native_library_sha256'))
                    or any(control['environments']['A'][key] != identities['A'][key]
                           for key in ('extension_sha256', 'native_library_sha256'))
                    or control.get('f1_packet_sha256') != FROZEN[F1]['identity']['packet_sha256']):
                raise RuntimeError('--fit comparison needs a passing same-host, same-A-image A=A --control')
            # The Cp control has no fit arm: its serial evaluations only.
            if control and (set(control['cases'][F1].get('fits', {})) != set('AB') or any(ceilings(
                    case, control['cases'][case]['evaluations'], control['cases'][case].get('fits', {}).items(),
                    control=True) for case in FROZEN)):
                raise RuntimeError('A=A control has incomplete, invalid or over-ceiling evidence')
            fits = {}
            for label in ('A', 'B'):
                stop(label)
                directory = out / f'fit-cpu-{label}'
                launch(label, directory)
                # The serial timer-on sample verifies that profiling preserves the work and numerical values.
                timer_sample = call(label, F1)
                retain(label, F1, 'timer', timer_sample)
                if physical_difference(timer_sample, baseline[F1][label], F1_VALUES)[0] > STATE_TOLERANCE:
                    summary['gate_failures'].append(f'F1 {label} timer changed numerical values')
                for path in directory.glob('*.csv'):
                    path.rename(out / f'timer-{label}-{path.name}')
                fits[label] = call(label, F1, operation='fit')
                fit_cpu(directory, fits[label])
            if control and any(control['cases'][F1]['fits'][label]['workers'] != fits[label]['workers'] for label in 'AB'):
                raise RuntimeError('A=A control worker count differs')
            f1['fits'] = fits
            f1['control_wall_seconds'] = ([control['cases'][F1]['fits'][label]['seconds'] for label in 'AB']
                                         if control else [fits[label]['seconds'] for label in 'AB'])
            print(f'F1 A=A control wall range: {min(f1["control_wall_seconds"]):.6f}–'
                  f'{max(f1["control_wall_seconds"]):.6f} s', flush=True)
            difference = physical_difference(fits['A'], fits['B'], FIT_VALUES)[0]
            f1['fit_max_state_difference'] = difference
            if difference > STATE_TOLERANCE:
                summary['gate_failures'].append(f'F1 fit numerical difference {difference}')
            summary['gate_failures'].extend(ceilings(F1, {}, fits.items()))
            summary['gate_failures'].extend(gate(work_rows, state_rows, args.expect_change))
        summary['f1_packet_sha256'] = FROZEN[F1]['identity']['packet_sha256']
    except Exception as error:
        summary['error'] = f'{type(error).__name__}: {error}'
        raise
    finally:
        for label in processes:
            if processes[label].stdin and not processes[label].stdin.closed:
                stop(label)
        for filename, rows in (('work.csv', work_rows), ('states.csv', state_rows), ('pairs.csv', pair_rows), ('starts.csv', start_rows)):
            if rows:
                write_csv(out / filename, rows)
        summary['runtime_seconds'] = time.perf_counter() - begun
        summary['input_sha256'] = {str(path.relative_to(ROOT)): digest(path) for path in (
            Path(__file__).resolve(), *(path for fixture in FROZEN.values() for path in (fixture['input'], fixture['identity_path'])),
            ROOT / 'analyses/2026-tpd-phase-discovery/scripts/baseline.py',
            ROOT / 'analyses/2026-khudaida-idaes-settler/scripts/run_fixed_settler.py',
            ROOT / 'analyses/reproduction/2026-khudaida/figures/figure-02/source/source-points.csv',
            ROOT / 'analyses/2026-khudaida-idaes-settler/inputs/data/khudaida-2026-figure-2-electrolyte-lle/7/parameters/parameters.json',
            ROOT / 'data/packets/mea-co2-h2o-nine-species-estimation/3/parameters/parameters.json',
            ROOT / 'engine/tests/equilibrium/test_trace_reliability.py',
            *(ROOT / 'engine/data/reference' / path for path in (
                'mea-nominally-unloaded/request.json', 'mea-nominally-unloaded/parameters.json', 'mea-zero-inventory/ideal-calorics.json')))}
        (out / 'summary.json').write_text(json.dumps(summary, indent=2, allow_nan=False) + '\n')
    print(f'Retained {out}; runtime {summary["runtime_seconds"]:.3f} s', flush=True)
    for line in summary['gate_failures']:
        print(f'GATE FAILED: {line}', flush=True)
    return 1 if summary['gate_failures'] else 0


if __name__ == '__main__':
    if sys.argv[1:] == ['--worker']:
        worker()
    else:
        sys.exit(main())
