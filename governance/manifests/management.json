{
  "schema_version": 2,
  "doctrine_revision": 25,
  "repository": "tannerpolley/ePC-SAFT",
  "visibility": "private",
  "default_branch": "main",
  "canonical_local_path": "~/Workspaces/Engineering/ePC-SAFT-project",
  "artifact_root": "~/Workspaces/Engineering/ePC-SAFT-local-state/artifacts",
  "rollback_root": "~/Workspaces/Engineering/ePC-SAFT-local-state",
  "ci_cd": "disabled",
  "codex_environment": ".codex/environments/environment.toml",
  "distribution": {
    "name": "epcsaft",
    "source": "engine",
    "modules": [
      "epcsaft",
      "epcsaft.equilibrium",
      "epcsaft.regression"
    ],
    "editable_install": "forbidden",
    "split_distributions": "forbidden"
  },
  "areas": {
    "governance": {
      "path": "governance",
      "role": "doctrine_and_control_records"
    },
    "engine": {
      "path": "engine",
      "role": "runtime_and_compact_numerical_evidence"
    },
    "data": {
      "path": "data",
      "role": "canonical_scientific_packets"
    },
    "validation": {
      "path": "validation",
      "role": "installed_artifact_campaigns"
    }
  },
  "vertical_slice": {
    "accountable_owner": "engine_task",
    "normal_paths": [
      "data",
      "engine",
      "validation"
    ]
  },
  "external_repositories": {
    "organization_profile": {
      "github": "ePC-SAFT/.github",
      "local_path": "~/Workspaces/Engineering/ePC-SAFT-github-profile",
      "role": "thin_organization_profile"
    }
  },
  "source_repositories": [
    "ePC-SAFT/ePC-SAFT-governance",
    "ePC-SAFT/ePC-SAFT-engine",
    "ePC-SAFT/ePC-SAFT-data",
    "ePC-SAFT/ePC-SAFT-validation",
    "ePC-SAFT/ePC-SAFT-lab"
  ],
  "artifact_dispositions": "manifests/artifact-dispositions.json",
  "parameter_ownership": "manifests/parameter-ownership.json",
  "data_packet_locks": "manifests/data-packet-locks.json",
  "runtime_consolidation": "manifests/runtime-consolidation.json",
  "approved_operations": "manifests/approved-operations.json",
  "downstream_applications": "manifests/downstream-applications.json"
}
