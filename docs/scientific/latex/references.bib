@article{Ascani2022pH,
  title = {Prediction of {{pH}} in Multiphase Multicomponent Systems with {{ePC-SAFT}} Advanced},
  author = {Ascani, Moreno and Pabsch, Daniel and Klinksiek, Marcel and {Gajardo-Parra}, Nicol{\'a}s and Sadowski, Gabriele and Held, Christoph},
  year = 2022,
